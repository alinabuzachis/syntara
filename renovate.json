{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "gitIgnoredAuthors": [
    "github-actions[bot]",
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "automerge": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "rangeStrategy": "bump",
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Group minor/patch Python dependency updates into a single PR",
      "matchManagers": ["pep621"],
      "matchFileNames": ["backend/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "python dependencies (minor)",
      "schedule": ["before 6am on Monday"],
      "rangeStrategy": "in-range-only"
    },
    {
      "description": "Group major Python dependency updates separately",
      "matchManagers": ["pep621"],
      "matchFileNames": ["backend/**"],
      "matchUpdateTypes": ["major"],
      "groupName": "python dependencies (major)",
      "schedule": ["before 6am on Monday"],
      "rangeStrategy": "in-range-only"
    },
    {
      "description": "Disable pip_requirements manager for generated files — requirements.txt is exported from uv.lock, not a source of truth. The konflux-requirements-sync.yml workflow handles syncing it on MintMaker PRs.",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["backend/requirements.txt", "backend/requirements-build.txt"],
      "enabled": false
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm dependencies",
      "matchFileNames": ["frontend/**"],
      "schedule": ["before 6am on Monday"],
      "rangeStrategy": "bump"
    },
    {
      "matchPackageNames": ["quay.io/aap-ci/*"],
      "automerge": true
    },
    {
      "description": "Disable all renovate updates on the early-access branch",
      "matchBaseBranches": ["early-access"],
      "enabled": false
    }
  ]
}
