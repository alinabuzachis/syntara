{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": ["pip-requirements"],
      "enabled": false
    },
    {
      "matchManagers": ["pep621"],
      "groupName": "python dependencies",
      "schedule": ["before 6am on Monday"]
    },
    {
      "matchPackageNames": ["quay.io/aap-ci/*"],
      "automerge": true
    }
  ]
}
