# Build stage - use native platform for faster builds
FROM --platform=$BUILDPLATFORM mirror.gcr.io/library/node:24.4.0-alpine@sha256:3ab1d8a775153425c45ac8c6434c8717fae5866d9dc3e494dc7eb8550d71c75f AS builder

ARG TARGETPLATFORM
ARG BUILDPLATFORM

WORKDIR /app

COPY LICENSE /licenses/LICENSE
COPY packages/syntara-ui/LICENSE /licenses/syntara-ui-LICENSE

RUN apk add --no-cache openssl
RUN printf "demo:$(openssl passwd -apr1 coffee)\n" > /app/.htpasswd
COPY package.json package-lock.json ./
COPY packages/syntara-contracts/package.json ./packages/syntara-contracts/
COPY packages/syntara-ui/package.json ./packages/syntara-ui/
RUN npm ci --no-fund --no-audit --ignore-scripts
COPY . .
# Rebuild workspace packages to ensure symlinks are valid after source copy
RUN npm rebuild
# RUN npm run test
RUN npm run build

# Production stage - target platform will be used automatically
FROM mirror.gcr.io/library/nginx:1.27.4-alpine@sha256:4ff102c5d78d254a6f0da062b3cf39eaf07f01eec0927fd21e219d0af8bc0591

COPY --from=builder /licenses /licenses

COPY --from=builder /app/packages/syntara-ui/dist /usr/share/nginx/html
COPY packages/syntara-ui/nginx.conf.template /etc/nginx/templates/default.conf.template
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
