{
  "name": "@ansible/nexus-contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "scripts": {
    "gen:local": "concurrently npm:gen:local:* -c auto && cd ../.. && npm run format",
    "gen:local:admin": "npx openapi-typescript ../../../backend/src/nexus/schemas/admin/openapi.yaml --output ./src/admin-api.ts --default-non-nullable false",
    "gen:local:auth": "npx openapi-typescript ../../../backend/src/nexus/schemas/auth/openapi.yaml --output ./src/auth-api.ts --default-non-nullable false",
    "gen:local:users": "npx openapi-typescript ../../../backend/src/nexus/schemas/users/openapi.yaml --output ./src/users-api.ts --default-non-nullable false",
    "gen:local:identity-providers": "npx openapi-typescript ../../../backend/src/nexus/schemas/identity_providers/openapi.yaml --output ./src/identity-providers-api.ts --default-non-nullable false",
    "gen:local:tool-manager": "npx openapi-typescript ../../../backend/src/nexus/schemas/tool_manager/openapi.yaml --output ./src/tool-manager.ts --default-non-nullable false",
    "gen:local:workflow": "npx openapi-typescript ../../../backend/src/nexus/schemas/workflows/v2/openapi.yaml --output ./src/workflow-api.ts --default-non-nullable false",
    "gen:local:files": "npx openapi-typescript ../../../backend/src/nexus/schemas/files/openapi.yaml --output ./src/files-api.ts --default-non-nullable false",
    "gen:local:aap": "npx openapi-typescript ../../../backend/src/nexus/schemas/aap/openapi.yaml --output ./src/aap-api.ts --default-non-nullable false",
    "gen:local:audit": "npx openapi-typescript ../../../backend/src/nexus/schemas/audit/openapi.yaml --output ./src/audit-api.ts --default-non-nullable false",
    "gen:local:approvals": "npx openapi-typescript ../../../backend/src/nexus/schemas/approvals/openapi.yaml --output ./src/approvals-api.ts --default-non-nullable false",
    "gen:local:executions": "npx openapi-typescript ../../../backend/src/nexus/schemas/workflows/v2/executions_openapi.yaml --output ./src/executions-api.ts --default-non-nullable false",
    "gen:local:invocations": "npx openapi-typescript ../../../backend/src/nexus/schemas/invocations/openapi.yaml --output ./src/invocations-api.ts --default-non-nullable false",
    "gen:local:metrics": "npx openapi-typescript ../../../backend/src/nexus/schemas/internal_metrics/openapi.yaml --output ./src/metrics-api.ts --default-non-nullable false",
    "gen:local:tool-manager-metrics": "npx openapi-typescript ../../../backend/src/nexus/schemas/tool_manager/metrics.openapi.yaml --output ./src/tool-manager-metrics.ts --default-non-nullable false",
    "gen:local:node-outputs": "node ./scripts/generate-node-output-schemas.mjs",
    "gen:local:settings": "npx openapi-typescript ../../../backend/src/nexus/schemas/settings/openapi.yaml --output ./src/settings-api.ts --default-non-nullable false",
    "gen:local:credentials": "npx openapi-typescript ../../../backend/src/nexus/schemas/credentials/openapi.yaml --output ./src/credentials-api.ts --default-non-nullable false",
    "gen:local:projects": "npx openapi-typescript ../../../backend/src/nexus/schemas/projects/openapi.yaml --output ./src/projects-api.ts --default-non-nullable false",
    "gen:local:authz": "npx openapi-typescript ../../../backend/src/nexus/schemas/authz/openapi.yaml --output ./src/authz-api.ts --default-non-nullable false",
    "gen:local:roles": "npx openapi-typescript ../../../backend/src/nexus/schemas/authz/role.openapi.yaml --output ./src/roles-api.ts --default-non-nullable false",
    "gen:local:policies": "npx openapi-typescript ../../../backend/src/nexus/schemas/authz/policy.openapi.yaml --output ./src/policies-api.ts --default-non-nullable false",
    "gen:local:role-assignments": "npx openapi-typescript ../../../backend/src/nexus/schemas/authz/role_assignment.openapi.yaml --output ./src/role-assignments-api.ts --default-non-nullable false",
    "gen:local:examples": "cp -r ../../../backend/tests/integration/workflow/examples ../nexus-mock-api/src"
  }
}
