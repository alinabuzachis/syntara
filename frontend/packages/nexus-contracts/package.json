{
  "name": "@ansible/nexus-contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "scripts": {
    "gen:ts": "concurrently npm:gen:local:* -c auto && cd ../.. && npm run format",
    "gen:local": "npm run gen:ts && npm run sync-examples",
    "gen:local:admin": "openapi-typescript ../../../backend/src/nexus/schemas/admin/openapi.yaml --output ./src/admin-api.ts --default-non-nullable false",
    "gen:local:auth": "openapi-typescript ../../../backend/src/nexus/schemas/auth/openapi.yaml --output ./src/auth-api.ts --default-non-nullable false",
    "gen:local:users": "openapi-typescript ../../../backend/src/nexus/schemas/users/openapi.yaml --output ./src/users-api.ts --default-non-nullable false",
    "gen:local:identity-providers": "openapi-typescript ../../../backend/src/nexus/schemas/identity_providers/openapi.yaml --output ./src/identity-providers-api.ts --default-non-nullable false",
    "gen:local:integrations": "openapi-typescript ../../../backend/src/nexus/schemas/integrations/openapi.yaml --output ./src/integrations-api.ts --default-non-nullable false",
    "gen:local:tool-manager": "openapi-typescript ../../../backend/src/nexus/schemas/tool_manager/openapi.yaml --output ./src/tool-manager.ts --default-non-nullable false",
    "gen:local:workflow": "openapi-typescript ../../../backend/src/nexus/schemas/workflows/v2/openapi.yaml --output ./src/workflow-api.ts --default-non-nullable false",
    "gen:local:files": "openapi-typescript ../../../backend/src/nexus/schemas/files/openapi.yaml --output ./src/files-api.ts --default-non-nullable false",
    "gen:local:aap": "openapi-typescript ../../../backend/src/nexus/schemas/aap/openapi.yaml --output ./src/aap-api.ts --default-non-nullable false",
    "gen:local:approvals": "openapi-typescript ../../../backend/src/nexus/schemas/approvals/openapi.yaml --output ./src/approvals-api.ts --default-non-nullable false",
    "gen:local:executions": "openapi-typescript ../../../backend/src/nexus/schemas/workflows/v2/executions_openapi.yaml --output ./src/executions-api.ts --default-non-nullable false",
    "gen:local:invocations": "openapi-typescript ../../../backend/src/nexus/schemas/invocations/openapi.yaml --output ./src/invocations-api.ts --default-non-nullable false",
    "gen:local:metrics": "openapi-typescript ../../../backend/src/nexus/schemas/internal_metrics/openapi.yaml --output ./src/metrics-api.ts --default-non-nullable false",
    "gen:local:tool-manager-metrics": "openapi-typescript ../../../backend/src/nexus/schemas/tool_manager/metrics.openapi.yaml --output ./src/tool-manager-metrics.ts --default-non-nullable false",
    "gen:local:node-outputs": "node ./scripts/generate-node-output-schemas.mjs",
    "gen:local:settings": "openapi-typescript ../../../backend/src/nexus/schemas/settings/openapi.yaml --output ./src/settings-api.ts --default-non-nullable false",
    "gen:local:credentials": "openapi-typescript ../../../backend/src/nexus/schemas/credentials/openapi.yaml --output ./src/credentials-api.ts --default-non-nullable false",
    "gen:local:projects": "openapi-typescript ../../../backend/src/nexus/schemas/projects/openapi.yaml --output ./src/projects-api.ts --default-non-nullable false",
    "gen:local:authz": "openapi-typescript ../../../backend/src/nexus/schemas/authz/openapi.yaml --output ./src/authz-api.ts --default-non-nullable false",
    "gen:local:roles": "openapi-typescript ../../../backend/src/nexus/schemas/authz/role.openapi.yaml --output ./src/roles-api.ts --default-non-nullable false",
    "gen:local:policies": "openapi-typescript ../../../backend/src/nexus/schemas/authz/policy.openapi.yaml --output ./src/policies-api.ts --default-non-nullable false",
    "gen:local:role-assignments": "openapi-typescript ../../../backend/src/nexus/schemas/authz/role_assignment.openapi.yaml --output ./src/role-assignments-api.ts --default-non-nullable false",
    "sync-examples": "cp -r ../../../backend/tests/integration/workflows/examples ../nexus-mock-api/src",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
