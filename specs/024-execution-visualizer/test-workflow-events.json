    "workflow": {
      "activities": [
        {
          "id": "fetch_data",
          "type": "task",
          "name": "Fetch Data",
          "task": {
            "executor": "api",
            "config": {
              "method": "GET",
              "url": "https://api.example.com/data"
            }
          }
        },
        {
          "id": "validate_input",
          "type": "task",
          "name": "Validate Input",
          "task": {
            "executor": "script",
            "config": {
              "language": "python",
              "code": "print('Validating input...')"
            }
          }
        },
        {
          "id": "process_data",
          "type": "task",
          "name": "Process Data",
          "task": {
            "executor": "agentic",
            "config": {
              "agent": "data-processor",
              "prompt": "Process the data"
            }
          }
        },
        {
          "id": "send_notification",
          "type": "task",
          "name": "Send Notification",
          "task": {
            "executor": "aap_job_template",
            "config": {
              "jobTemplateId": 123
            }
          }
        },
        {
          "id": "cleanup",
          "type": "task",
          "name": "Cleanup",
          "task": {
            "executor": "script",
            "config": {
              "language": "bash",
              "code": "echo 'Cleaning up...'"
            }
          }
        }
      ]
    }
