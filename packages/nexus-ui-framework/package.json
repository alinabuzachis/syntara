{
  "name": "@ansible/nexus-ui-framework",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/nexus-ui-framework.umd.js",
  "module": "./dist/nexus-ui-framework.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/nexus-ui-framework.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/nexus-ui-framework.umd.js"
      }
    },
    "./style.css": "./dist/nexus-ui-framework.css"
  },
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "start": "vite build --watch",
    "dev": "vite --open",
    "build": "vite build",
    "test": "concurrently npm:eslint npm:tsc",
    "tsc": "tsc --noEmit",
    "eslint": "eslint ."
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@base-ui-components/react": "^1.0.0-beta.4",
    "@eslint/js": "^9.38.0",
    "@tailwindcss/vite": "^4.1.15",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "clsx": "^2.1.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "lucide-react": "^0.546.0",
    "react-hook-form": "^7.65.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.11",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-externalize-deps": "^0.10.0"
  }
}
