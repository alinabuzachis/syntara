{
  "name": "@ansible/nexus-contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "scripts": {
    "gen": "npm run nexus:checkout && concurrently npm:gen:* -c auto && npm run nexus:clean && cd ../.. && npm run format",
    "nexus:checkout": "rm -rf nexus && git clone git@github.com:syntara-orchestration/syntara.git",
    "gen:auth": "npx openapi-typescript ./nexus/src/nexus/schemas/auth/openapi.yaml --output ./src/auth-api.ts --default-non-nullable false",
    "gen:users": "npx openapi-typescript ./nexus/src/nexus/schemas/users/openapi.yaml --output ./src/users-api.ts --default-non-nullable false",
    "gen:identity-providers": "npx openapi-typescript ./nexus/src/nexus/schemas/identity_providers/openapi.yaml --output ./src/identity-providers-api.ts --default-non-nullable false",
    "gen:tool-manager": "npx openapi-typescript ./nexus/src/nexus/schemas/tool_manager/openapi.yaml --output ./src/tool-manager.ts --default-non-nullable false",
    "gen:workflow": "npx openapi-typescript ./nexus/src/nexus/schemas/workflows/v2/openapi.yaml --output ./src/workflow-api.ts --default-non-nullable false",
    "gen:files": "npx openapi-typescript ./nexus/src/nexus/schemas/files/openapi.yaml --output ./src/files-api.ts --default-non-nullable false",
    "gen:aap": "npx openapi-typescript ./nexus/src/nexus/schemas/aap/openapi.yaml --output ./src/aap-api.ts --default-non-nullable false",
    "gen:audit": "npx openapi-typescript ./nexus/src/nexus/schemas/audit/openapi.yaml --output ./src/audit-api.ts --default-non-nullable false",
    "gen:approvals": "npx openapi-typescript ./nexus/src/nexus/schemas/approvals/openapi.yaml --output ./src/approvals-api.ts --default-non-nullable false",
    "gen:executions": "npx openapi-typescript ./nexus/src/nexus/schemas/workflows/v2/executions_openapi.yaml --output ./src/executions-api.ts --default-non-nullable false",
    "gen:invocations": "npx openapi-typescript ./nexus/src/nexus/schemas/invocations/openapi.yaml --output ./src/invocations-api.ts --default-non-nullable false",
    "gen:metrics": "npx openapi-typescript ./nexus/src/nexus/schemas/metrics/openapi.yaml --output ./src/metrics-api.ts --default-non-nullable false",
    "gen:tool-manager-metrics": "npx openapi-typescript ./nexus/src/nexus/schemas/tool_manager/metrics.yaml --output ./src/tool-manager-metrics.ts --default-non-nullable false",
    "gen:node-outputs": "node ./scripts/generate-node-output-schemas.mjs",
    "gen:settings": "npx openapi-typescript ./nexus/src/nexus/schemas/settings/openapi.yaml --output ./src/settings-api.ts --default-non-nullable false",
    "gen:credentials": "npx openapi-typescript ./nexus/src/nexus/schemas/credentials/openapi.yaml --output ./src/credentials-api.ts --default-non-nullable false",
    "gen:projects": "npx openapi-typescript ./nexus/src/nexus/schemas/projects/openapi.yaml --output ./src/projects-api.ts --default-non-nullable false",
    "gen:authz": "npx openapi-typescript ./nexus/src/nexus/schemas/authz/openapi.yaml --output ./src/authz-api.ts --default-non-nullable false",
    "gen:roles": "npx openapi-typescript ./nexus/src/nexus/schemas/authz/role.openapi.yaml --output ./src/roles-api.ts --default-non-nullable false",
    "gen:policies": "npx openapi-typescript ./nexus/src/nexus/schemas/authz/policy.openapi.yaml --output ./src/policies-api.ts --default-non-nullable false",
    "gen:role-assignments": "npx openapi-typescript ./nexus/src/nexus/schemas/authz/role_assignment.openapi.yaml --output ./src/role-assignments-api.ts --default-non-nullable false",
    "gen:examples": "cp -r ./nexus/tests/integration/workflow/examples ../nexus-mock-api/src",
    "nexus:clean": "rm -rf nexus"
  }
}
