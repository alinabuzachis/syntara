{
  "name": "@ansible/nexus-contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "scripts": {
    "gen": "npm run nexus:checkout && concurrently npm:gen:* -c auto && npm run nexus:clean && npm run build && cd ../.. && npm run format",
    "nexus:checkout": "git clone https://github.com/syntara-orchestration/syntara",
    "gen:tools": "npx openapi-typescript ./nexus/specs/004-tool-management/contracts/tools.yaml --output ./src/tools.ts --default-non-nullable false",
    "gen:tool-providers": "npx openapi-typescript ./nexus/specs/004-tool-management/contracts/tool-providers.yaml --output ./src/tool-providers.ts --default-non-nullable false",
    "gen:workflow": "npx openapi-typescript ./nexus/specs/003-workflow-engine/contracts/workflow-api.yaml --output ./src/workflow-api.ts --default-non-nullable false",
    "nexus:clean": "rm -rf nexus"
  }
}
