{
  "name": "@ansible/nexus-contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "scripts": {
    "gen": "npm run nexus:checkout && concurrently npm:gen:* -c auto && npm run nexus:clean && cd ../.. && npm run format",
    "nexus:checkout": "rm -rf nexus && git clone git@github.com:syntara-orchestration/syntara.git",
    "gen:tool-manager": "npx openapi-typescript ./nexus/src/nexus/schemas/tool_manager/openapi.yaml --output ./src/tool-manager.ts --default-non-nullable false",
    "gen:workflow": "npx openapi-typescript ./nexus/src/nexus/schemas/workflows/workflow-api.yaml --output ./src/workflow-api.ts --default-non-nullable false",
    "gen:files": "npx openapi-typescript ./nexus/src/nexus/schemas/files/files-api.yaml --output ./src/files-api.ts --default-non-nullable false",
    "gen:approvals": "npx openapi-typescript ./nexus/src/nexus/schemas/approvals/approvals-api.yaml --output ./src/approvals-api.ts --default-non-nullable false",
    "gen:examples": "cp -r ./nexus/tests/integration/workflow/examples ../nexus-mock-api/src",
    "nexus:clean": "rm -rf nexus"
  }
}
