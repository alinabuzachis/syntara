{
  "name": "@ansible/nexus-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "start": "vite --open",
    "build": "vite build",
    "test": "concurrently npm:lint npm:tsc npm:vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "node scripts/check-pr-coverage.js",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "vitest": "vitest run",
    "tsc": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "knip:exports": "knip --include files,exports,duplicates"
  },
  "dependencies": {
    "@ansible/nexus-contracts": "file:../nexus-contracts",
    "@dagrejs/dagre": "^2.0.4",
    "@patternfly/react-code-editor": "^6.5.0-prerelease.35",
    "@patternfly/react-core": "^6.5.0-prerelease.35",
    "@patternfly/react-table": "^6.5.0-prerelease.36",
    "@tanstack/react-query": "^5.90.21",
    "@xyflow/react": "^12.10.1",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.1.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "zod": "^4.3.6",
    "@hookform/resolvers": "^5.2.2",
    "uuid": "^13.0.0",
    "wouter": "^3.9.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "knip": "^5.85.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.18"
  }
}
