{
  "name": "@ansible/nexus-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "start": "concurrently -n app,sb 'vite --open' 'storybook dev -p 5174 --disable-telemetry' -c auto",
    "build": "vite build",
    "preview": "vite preview",
    "test": "concurrently npm:lint npm:tsc npm:vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:shard": "vitest run --coverage",
    "test:coverage:merge": "node scripts/merge-coverage.js",
    "test:coverage:report": "nyc report --temp-dir .nyc_output --report-dir coverage --reporter html --reporter lcov --reporter json --reporter json-summary --reporter text",
    "e2e": "playwright test --reporter=line",
    "e2e:ui": "playwright test --ui",
    "vitest": "vitest run",
    "tsc": "concurrently --raw -n app,node,storybook,e2e \"tsc --noEmit -p tsconfig.app.json\" \"tsc --noEmit -p tsconfig.node.json\" \"tsc --noEmit -p tsconfig.storybook.json\" \"tsc --noEmit -p tsconfig.e2e.json\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "knip:exports": "knip --include files,exports,duplicates,enumMembers,namespaceMembers",
    "storybook": "storybook dev -p 5174 --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "@ansible/nexus-contracts": "file:../nexus-contracts",
    "@dagrejs/dagre": "^2.0.4",
    "@hookform/resolvers": "^5.2.2",
    "@patternfly/react-code-editor": "^6.5.0-prerelease.77",
    "@patternfly/react-core": "^6.5.0-prerelease.74",
    "@patternfly/react-table": "^6.5.0-prerelease.78",
    "@tanstack/react-query": "^5.99.0",
    "@xyflow/react": "^12.10.2",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.3.0",
    "jmespath": "^0.16.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "uuid": "^14.0.0",
    "wouter": "^3.9.0",
    "zod": "^4.3.6",
    "zundo": "^2.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/react-vite": "10.3.6",
    "@tanstack/eslint-plugin-query": "^5.97.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jmespath": "^0.15.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/eslint-plugin": "^1.6.15",
    "babel-plugin-react-compiler": "^19.1.0-rc.1-rc-af1b7da-20250421",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.10.1",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "knip": "^6.4.1",
    "nyc": "^18.0.0",
    "prettier": "^3.8.2",
    "storybook": "10.3.6",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^7.3.2",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.4",
    "vitest-axe": "^1.0.0-pre.5"
  }
}
