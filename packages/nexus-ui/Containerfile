# Build stage - use native platform for faster builds
FROM --platform=$BUILDPLATFORM node:24-alpine AS builder

ARG TARGETPLATFORM
ARG BUILDPLATFORM

WORKDIR /app
RUN apk add --no-cache openssl
RUN printf "demo:$(openssl passwd -apr1 coffee)\n" > /app/.htpasswd
COPY package.json package-lock.json ./
COPY packages/nexus-contracts/package.json ./packages/nexus-contracts/
COPY packages/nexus-ui/package.json ./packages/nexus-ui/
RUN npm ci
COPY . .
# Rebuild workspace packages to ensure symlinks are valid after source copy
RUN npm rebuild
# RUN npm run test
RUN npm run build

# Production stage - target platform will be used automatically
FROM nginx:alpine

COPY --from=builder /app/packages/nexus-ui/dist /usr/share/nginx/html
COPY packages/nexus-ui/nginx.conf.template /etc/nginx/templates/default.conf.template
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
