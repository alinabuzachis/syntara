# Build stage - use native platform for faster builds
FROM --platform=$BUILDPLATFORM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
COPY packages/nexus-ui/package*.json ./packages/nexus-ui/
COPY packages/nexus-ui-framework/package*.json ./packages/nexus-ui-framework/
RUN npm ci
COPY . .
RUN npm run build

# Production stage
FROM nginx:alpine
COPY --from=builder /app/packages/nexus-ui/dist /usr/share/nginx/html
COPY packages/nexus-ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY packages/nexus-ui/.htpasswd /etc/nginx/.htpasswd
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
