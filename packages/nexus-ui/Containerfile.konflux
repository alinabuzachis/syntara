# Konflux-specific Containerfile using UBI9 for Red Hat certification
# This is used by Konflux pipelines for official builds
# For local development, use packages/nexus-ui/Containerfile

# Build stage
FROM registry.access.redhat.com/ubi9/nodejs-24:latest@sha256:79f32ae70b1f0f67e579f8545b20ffb5304992bc4874e8c1907619cadb12077b AS builder

USER root

WORKDIR /app

# Copy package files for dependency installation
COPY package.json package-lock.json ./
COPY packages/nexus-contracts/package.json ./packages/nexus-contracts/
COPY packages/nexus-ui/package.json ./packages/nexus-ui/

# Install dependencies (CI=true for deterministic builds, --no-fund to reduce output)
RUN CI=true npm ci --no-fund

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Production stage - use ubi9 nginx image
FROM registry.redhat.io/ubi9/nginx-124:latest@sha256:ece0c2d70199f0bcd3316d6913ef4b8e815d0229693156dee4bad8d69b13edc6

USER 0

# Copy built application to the location expected by ubi9/nginx-124
COPY --from=builder --chown=1001:0 /app/packages/nexus-ui/dist /opt/app-root/src

# Copy Konflux-specific nginx config (port 8080, points to nexus-api service)
COPY --chown=1001:0 packages/nexus-ui/nginx.konflux.conf /etc/nginx/conf.d/default.conf

# Switch to non-root user
USER 1001

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
