# Stage 1: Builder - uses python-312 image where Python is pre-installed
FROM registry.access.redhat.com/ubi9/python-312:latest@sha256:e95978812895b9abb2bdc109b501078da2a47c8dbb9fa23758af40ed50ab6023 AS builder

# Switch to root to install dependencies
USER root

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/opt/app-root/src/src

# Install uv for fast dependency management
RUN pip install --no-cache-dir uv

# Set working directory
WORKDIR /opt/app-root/src

# Copy dependency files first (for layer caching)
COPY pyproject.toml uv.lock LICENSE README.md alembic.ini requirements.txt ./

# Install dependencies using uv (including dev dependencies)
RUN if [ -n "${PIP_FIND_LINKS}" ]; then \
        uv venv && \
        uv pip install --no-index --find-links "${PIP_FIND_LINKS}" \
            -r requirements.txt; \
    else \
        uv sync --frozen; \
    fi

# Copy application code
COPY src/ ./src/
COPY tools/ ./tools/
COPY samples/ ./samples/

# Stage 2: Runtime - minimal image with Python and app copied from builder
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest@sha256:83006d535923fcf1345067873524a3980316f51794f01d8655be55d6e9387183

USER root

# Install Python 3.12 runtime and dependencies via RPM
RUN microdnf install --setopt=install_weak_deps=0 --nodocs -y \
        python3.12 \
        python3.12-pip \
        python3.12-cffi \
    && microdnf clean all

# Set python3 symlink via alternatives
RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1

# Copy license file for Red Hat certification (HasLicense check)
COPY LICENSE /licenses/LICENSE

# Copy application, venv, and uv from builder
COPY --from=builder /opt/app-root/ /opt/app-root/

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/opt/app-root/src/src \
    PATH="/opt/app-root/src/.venv/bin:/opt/app-root/bin:$PATH"

WORKDIR /opt/app-root/src

# Fix permissions for OpenShift/UBI (runs as arbitrary UID)
RUN chown -R 1001:0 /opt/app-root && \
    chmod -R g=u /opt/app-root

# Switch back to non-root user (UBI default user)
USER 1001

# Expose API port
EXPOSE 8000

# Default command runs the API server
# Override with different commands for other services.
CMD ["uvicorn", "nexus.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
