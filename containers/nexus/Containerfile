FROM registry.access.redhat.com/ubi9/python-312:latest

# Switch to root to install dependencies
USER root

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install uv for fast dependency management
RUN pip install --no-cache-dir uv

# Set working directory
WORKDIR /opt/app-root/src

# Copy dependency files first (for layer caching)
COPY pyproject.toml uv.lock LICENSE README.md alembic.ini ./

# Install dependencies using uv (including dev dependencies)
RUN uv sync --frozen

# Copy application code
COPY src/ ./src/
COPY tools/ ./tools/
COPY samples/ ./samples/

# Fix permissions for OpenShift/UBI (runs as arbitrary UID)
RUN chown -R 1001:0 /opt/app-root && \
    chmod -R g=u /opt/app-root

# Switch back to non-root user (UBI default user)
USER 1001

# Expose API port
EXPOSE 8000

# Default command runs the API server
# Override with different commands for other services.
CMD ["sh", "-c", "uv run uvicorn nexus.api.main:app --host 0.0.0.0 --port 8000"]
