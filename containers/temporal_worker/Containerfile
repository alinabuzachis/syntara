# Temporal Worker Container
#
# This container runs the Temporal worker that executes workflow tasks.
# It polls the Temporal server for workflow and activity tasks to execute.
#
# Build: podman build -t nexus-temporal-worker:latest -f containers/temporal_worker/Containerfile .
# Run: podman run --env-file .env nexus-temporal-worker:latest

FROM python:3.12-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    bash \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
RUN pip install uv

# Set working directory
WORKDIR /app

# Copy dependency files first (for layer caching)
COPY pyproject.toml uv.lock LICENSE README.md ./

# Install dependencies using uv (including dev dependencies)
RUN uv sync --frozen

# Copy application code
COPY src/ ./src/

# Create non-root user for security
RUN useradd -m -u 1000 nexus && \
    chown -R nexus:nexus /app

USER nexus

# Health check - verify worker process is running
# TODO: Implement a more robust health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD pgrep -f "nexus.workflows.worker" || exit 1

# Run the Temporal worker
CMD ["uv", "run", "python", "-m", "nexus.workflows.worker"]
