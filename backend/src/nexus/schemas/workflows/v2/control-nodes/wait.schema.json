{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syntara-orchestration.io/schemas/workflows/v2/control-nodes/wait",
  "title": "Wait Node",
  "description": "Pause workflow execution for a specified duration in seconds.",
  "parameterSchema": {
    "type": "object",
    "required": [
      "duration"
    ],
    "properties": {
      "duration": {
        "type": "integer",
        "minimum": 1,
        "description": "Total wait duration in seconds"
      }
    },
    "additionalProperties": false
  },
  "settingSchema": {
    "$ref": "../common-definitions.schema.json#/$defs/nodeSettingsCof"
  },
  "resultSchema": {
    "description": "Result structure available in result namespace",
    "oneOf": [
      {
        "title": "Completed Result",
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "completed",
            "description": "Wait duration elapsed successfully"
          }
        },
        "additionalProperties": false
      },
      {
        "title": "Failed Result",
        "type": "object",
        "required": [
          "status",
          "error"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "failed"
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "All executor fields are present but nullable. A null value means the failure occurred before that field was available."
      }
    ],
    "discriminator": {
      "propertyName": "status"
    }
  }
}
