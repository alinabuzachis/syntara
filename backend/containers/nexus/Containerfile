FROM registry.redhat.io/ansible-automation-platform/uv-builder-rhel9:latest@sha256:bdd64fcb4597cfb665c15c4b4841ded098baa26dce1f544b4dbd17a575b8984a AS builder

USER 0

ENV PYTHON=python3.12 \
    PYO3_PYTHON=python3.12 \
    UV_LOCK_TIMEOUT=1800 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_USE_PEP517=1 \
    PYTHONPATH=/opt/app-root/src/src

WORKDIR /opt/app-root/src

# Copy dependency files first (for layer caching)
COPY pyproject.toml uv.lock LICENSE README.md alembic.ini ./
COPY tools/ci/sanitize_pyproject_for_hermetic.py /usr/local/bin/sanitize_pyproject_for_hermetic.py

# Copy application code (excluding ./tools)
COPY src/ ./src/

# Hermetic Konflux builds: use uv against Hermeto-prefetched sdists.
# cachi2.env injects PIP_FIND_LINKS/PIP_NO_INDEX; we map that flat directory to
# uv with --find-links/--no-index and run fully offline.
# Lock metadata is refreshed in-build against the mounted cache because the
# Hermeto prefetch directory is generated dynamically per build.
# MuPDF source is taken from Hermeto generic artifacts and extracted locally so
# PyMuPDF never tries to download it from mupdf.com during offline builds.
# requirements-build.txt still matters for prefetch completeness even though uv
# performs the actual isolated build/install steps.
# Local (non-hermetic) builds fall through to normal uv sync.
# hadolint ignore=SC2086
RUN if [ -n "${PIP_FIND_LINKS:-}" ]; then \
        # --- Hermetic build (Konflux / cachi2) ---
        # uv lock resolves from pyproject metadata, so strip optional/integration
        # sections from pyproject in-container before refreshing the lock.
        python3.12 /usr/local/bin/sanitize_pyproject_for_hermetic.py pyproject.toml && \
        UV_FIND_LINKS="${PIP_FIND_LINKS}" \
        uv lock --offline --no-index --find-links "${PIP_FIND_LINKS}" && \
        UV_FIND_LINKS="${PIP_FIND_LINKS}" \
        uv sync --frozen --no-dev --no-editable --no-index --find-links "${PIP_FIND_LINKS}" --offline --no-binary; \
    else \
        # --- Local (non-hermetic) build ---
        uv sync --frozen --no-dev; \
    fi

# Stage 2: Runtime - minimal image with Python and app copied from builder
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest@sha256:83006d535923fcf1345067873524a3980316f51794f01d8655be55d6e9387183

ARG CONTAINER_IMAGE_VERSION=""
ARG APP_SEGMENT_WRITE_KEY=""

USER root

# Install Python 3.12 runtime and dependencies via RPM
RUN microdnf install --setopt=install_weak_deps=0 --nodocs -y \
        python3.12 \
        python3.12-pip \
        python3.12-cffi \
    && microdnf clean all

# Set python3 symlink via alternatives
RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1

# Copy license file for Red Hat certification (HasLicense check)
COPY LICENSE /licenses/LICENSE

# Copy application and venv from builder
COPY --from=builder /opt/app-root/ /opt/app-root/
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/opt/app-root/src/src \
    PATH="/opt/app-root/src/.venv/bin:/opt/app-root/bin:$PATH" \
    APP_CONTAINER_IMAGE_VERSION="${CONTAINER_IMAGE_VERSION}" \
    APP_SEGMENT_WRITE_KEY="${APP_SEGMENT_WRITE_KEY}"

WORKDIR /opt/app-root/src

# Create data directories for file uploads and audit exports
RUN mkdir -p /data/file-uploads /data/audit-exports && \
    chown -R 1001:0 /data/file-uploads /data/audit-exports && \
    chmod -R g=u /data/file-uploads /data/audit-exports

# Fix permissions for OpenShift/UBI (runs as arbitrary UID)
RUN chown -R 1001:0 /opt/app-root && \
    chmod -R g=u /opt/app-root

# Switch back to non-root user (UBI default user)
USER 1001

# Expose API port
EXPOSE 8000

# Default command runs the API server
# Override with different commands for other services.
CMD ["uvicorn", "nexus.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
