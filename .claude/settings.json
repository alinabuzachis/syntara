{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; \"$ROOT/.claude/hooks/startup-skills.sh\" || true'",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel) && \"$ROOT/.claude/hooks/format-on-save.sh\"'",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; \"$ROOT/.claude/hooks/skill-ack.sh\"'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; \"$ROOT/.claude/hooks/skill-gate.sh\"'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel) && \"$ROOT/.claude/hooks/pre-commit-checks.sh\"'",
            "timeout": 120000
          },
          {
            "type": "command",
            "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel) && \"$ROOT/.claude/hooks/pre-pr-checks.sh\"'",
            "timeout": 300000
          }
        ]
      }
    ]
  }
}
