    def {{ short_name }}(self, **kwargs: Any) -> Response[Any]:
        endpoint_module = self._load_endpoint_module("{{ endpoint.name.replace('__', '_') }}")
        return endpoint_module.sync_detailed(client=self._client, **kwargs)

    async def async_{{ short_name }}(self, **kwargs: Any) -> Response[Any]:
        endpoint_module = self._load_endpoint_module("{{ endpoint.name.replace('__', '_') }}")
        return await endpoint_module.asyncio_detailed(client=self._client, **kwargs)

