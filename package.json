{
  "name": "next-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently npm:frontend -c auto",
    "frontend": "npm run start --prefix packages/frontend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "docker:build": "docker compose build",
    "docker:run": "docker compose up frontend"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "os": [
    "darwin",
    "linux",
    "windows"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
