{
  "name": "@ansible/nexus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run build:nexus-ui-framework && concurrently npm:start:* -c auto",
    "start:nexus-ui": "npm run start --prefix packages/nexus-ui",
    "start:nexus-mock-api": "npm run start --prefix packages/nexus-mock-api",
    "start:nexus-ui-framework": "npm run start --prefix packages/nexus-ui-framework",
    "build": "concurrently npm:build:nexus-ui-framework -c auto && concurrently npm:build:nexus-ui -c auto",
    "build:nexus-ui": "npm run build --workspace=packages/nexus-ui",
    "build:nexus-ui-framework": "npm run build --workspace=packages/nexus-ui-framework",
    "test": "npm run build && concurrently npm:test:* npm:format:check -c auto",
    "test:nexus-ui": "npm run test --prefix packages/nexus-ui",
    "test:nexus-ui-framework": "npm run test --prefix packages/nexus-ui-framework",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "npm run gen --prefix packages/nexus-contracts",
    "podman:build": "concurrently npm:podman:build:* -c auto",
    "podman:build:nexus-ui": "podman build -f packages/nexus-ui/Containerfile -t nexus-ui:latest -t ghcr.io/syntara-orchestration/syntara-ui:latest .",
    "podman:build:nexus-mock-api": "podman build -f packages/nexus-mock-api/Containerfile -t nexus-mock-api:latest -t ghcr.io/syntara-orchestration/syntara-mock-api:latest .",
    "podman:run": "concurrently npm:podman:run:* -c auto",
    "podman:run:nexus-ui": "podman run --rm -p 4000:80 --name nexus-ui ghcr.io/syntara-orchestration/syntara-ui:latest",
    "podman:run:nexus-mock-api": "podman run --rm -p 3000:3000 --name nexus-mock-api ghcr.io/syntara-orchestration/syntara-mock-api:latest"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1"
  },
  "os": [
    "darwin",
    "linux",
    "windows"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
