# ==============================================================================
# Nexus Combined Development Environment Configuration
# ==============================================================================
# Copy this file to .env and customize as needed
# DO NOT commit .env to version control

# ==============================================================================
# Backend Configuration
# ==============================================================================

# PostgreSQL Database Configuration
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=admin
APP_DB_PASSWORD=admin
APP_DB_NAME=nexus_api
APP_DB_POOL_SIZE=10
APP_DB_MAX_OVERFLOW=20
APP_DB_POOL_TIMEOUT_SECONDS=30

# Audit Database Configuration
APP_AUDIT_DB_NAME=nexus_audit
APP_AUDIT_DB_POOL_SIZE=5
APP_AUDIT_DB_MAX_OVERFLOW=10
APP_AUDIT_DB_POOL_TIMEOUT_SECONDS=30

# Audit Export Configuration (async CSV export via Temporal)
# APP_AUDIT_EXPORT_DIR=/tmp/nexus-audit-exports
# APP_AUDIT_EXPORT_TASK_QUEUE=nexus-workflow-queue
# APP_AUDIT_EXPORT_BATCH_SIZE=5000

# Temporal Workflow Engine Configuration
APP_TEMPORAL_PORT=7233
APP_TEMPORAL_UI_PORT=8081
APP_TEMPORAL_ADDRESS=localhost:7233
APP_TEMPORAL_NAMESPACE=default
APP_TASK_QUEUE=nexus-workflow-queue

# Podman Compose Configuration
PODMAN_PROJECT=nexus

# API and Service Ports
APP_API_PORT=8000
APP_UI_PORT=8080
APP_CACHE_HOST=localhost
APP_CACHE_PORT=6379
APP_CACHE_PASSWORD=cache

# JWT Authentication Configuration
# Run 'make -C backend secrets-generate' to create development keys
APP_JWT_PRIVATE_KEY_PATH=backend/.secrets/jwt-primary.pem
APP_JWT_BACKUP_KEYS=[{"key_id":"nexus-backup","key_path":"backend/.secrets/jwt-backup.pem"}]
APP_ADMIN_PASSWORD_PATH=backend/.secrets/admin-password
APP_SECRET_ENCRYPTION_KEY_PATH=backend/.secrets/encryption-key

# Server Configuration
APP_SERVER_SCHEME=http
APP_SERVER_PUBLIC_URL=http://localhost:8000
APP_CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Logging Configuration
APP_FALLBACK_LOG_LEVEL=INFO

# LLM Provider Configuration (OpenRouter)
APP_OPENROUTER_MODEL=anthropic/claude-sonnet-4
APP_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
APP_OPENROUTER_TEMPERATURE=0.7
APP_OPENROUTER_MAX_TOKENS=1000

# API Validation
APP_OPENAPI_VALIDATION_ENABLED=true
APP_ROUTER_DISCOVERY_ENABLED=true

# ==============================================================================
# Frontend Configuration
# ==============================================================================

# Frontend Development Ports (when running outside containers)
# UI: http://localhost:5173
# Mock API: http://localhost:3000
# Storybook: http://localhost:5174

# To connect frontend to real backend:
# VITE_API_URL=http://localhost:8000
