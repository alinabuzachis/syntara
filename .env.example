# Nexus Development Environment Configuration
# Copy this file to .env and customize as needed
# DO NOT commit .env to version control

# PostgreSQL Database Configuration
NEXUS_DB_HOST=localhost          # Database server hostname
NEXUS_DB_PORT=5432               # Database server port (change if 5432 conflicts)
NEXUS_DB_USER=admin              # Database username
NEXUS_DB_PASSWORD=admin          # Database password (simple for local development)
NEXUS_DB_NAME=nexus_api          # Initial database name

# Alternative: Full database URL (overrides individual components if set)
# DATABASE_URL=postgresql://admin:admin@localhost:5432/nexus_api

# Temporal Workflow Engine Configuration
NEXUS_TEMPORAL_PORT=7233         # Temporal server port
NEXUS_TEMPORAL_UI_PORT=8081      # Temporal UI web interface port
NEXUS_TEMPORAL_ADDRESS=localhost:7233     # Temporal server address
NEXUS_TEMPORAL_NAMESPACE=default # Temporal namespace
NEXUS_TASK_QUEUE=nexus-workflow-queue     # Task queue name for workflow execution

# Podman Compose Configuration
PODMAN_PROJECT=nexus             # Project name for podman-compose (affects container/volume names)
                                 # Change this when working with multiple instances on the same host

# API and Service Ports
NEXUS_API_PORT=8000              # API server port
NEXUS_UI_PORT=8080               # UI server port
VALKEY_PORT=6379                 # Valkey cache port

# Logging Configuration
LOG_LEVEL=INFO                   # Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# OpenRouter Configuration (NEXUS-002-4)
# OpenRouter is a third-party service that provides unified API access to multiple LLM providers
# (Claude, GPT-4, Gemini, etc.). This is used by Nexus agents for LLM interactions.
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet  # or openai/gpt-4, google/gemini-pro, etc.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# API Validation and Router Discovery Configuration
# =============================================================================

# OpenAPI Validation
# Enable validation of FastAPI routes against OpenAPI schema specifications.
# This checks that all defined API endpoints match their OpenAPI schemas.
# NOTE: This is NOT related to OpenRouter (the LLM service above).
OPENAPI_VALIDATION_ENABLED=true

# Router Discovery
# Enable automatic router discovery and registration.
# When enabled, routers are automatically discovered from domain directories
# without manual import and registration in main.py.
ROUTER_DISCOVERY_ENABLED=true

# Exclude Modules
# Comma-separated list of module names to exclude from automatic discovery.
# Example: "core,utils,websocket"
ROUTER_EXCLUDE_MODULES=
