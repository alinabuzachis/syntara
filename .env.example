# Nexus Development Environment Configuration
# Copy this file to .env and customize as needed
# DO NOT commit .env to version control
# You can set NEXUS_ENV_FILE_PATH to point to a different .env file if desired

# PostgreSQL Database Configuration
NEXUS_DB_HOST=localhost          # Database server hostname
NEXUS_DB_PORT=5432               # Database server port (change if 5432 conflicts)
NEXUS_DB_USER=admin              # Database username
NEXUS_DB_PASSWORD=admin          # Database password (simple for local development)
NEXUS_DB_NAME=nexus_api          # Initial database name
NEXUS_DB_POOL_SIZE=10            # SQLAlchemy pool: persistent connections
NEXUS_DB_MAX_OVERFLOW=20         # SQLAlchemy pool: extra temporary connections
NEXUS_DB_POOL_TIMEOUT_SECONDS=30 # Seconds to wait for connection before timeout

# Alternative: Full database URL (overrides individual NEXUS_DB_* settings if set)
# Supports URL-encoded passwords, alternate drivers, and query params (e.g., sslmode)
# NEXUS_DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/nexus_api?sslmode=require

# Temporal Workflow Engine Configuration
NEXUS_TEMPORAL_PORT=7233         # Temporal server port
NEXUS_TEMPORAL_UI_PORT=8081      # Temporal UI web interface port
NEXUS_TEMPORAL_ADDRESS=localhost:7233     # Temporal server address
NEXUS_TEMPORAL_NAMESPACE=default # Temporal namespace
NEXUS_TASK_QUEUE=nexus-workflow-queue     # Task queue name for workflow execution

# Podman Compose Configuration
PODMAN_PROJECT=nexus             # Project name for podman-compose (affects container/volume names)
                                 # Change this when working with multiple instances on the same host

# API and Service Ports
NEXUS_API_PORT=8000              # API server port
NEXUS_UI_PORT=8080               # UI server port
NEXUS_CACHE_HOST=localhost            # Cache server hostname
NEXUS_CACHE_PORT=6379                 # Cache server port
NEXUS_CACHE_PASSWORD=cache            # Cache server password (matches podman-compose.yml)

# Logging Configuration
NEXUS_LOG_LEVEL=INFO             # Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# OpenRouter Configuration (NEXUS-002-4)
# OpenRouter is a third-party service that provides unified API access to multiple LLM providers
# (Claude, GPT-4, Gemini, etc.). This is used by Nexus agents for LLM interactions.
# Get your API key from: https://openrouter.ai/keys
# IMPORTANT: Set this in your .env file - it's passed to containers via podman-compose.yml
NEXUS_OPENROUTER_API_KEY=your_openrouter_api_key_here
NEXUS_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet  # or openai/gpt-4, google/gemini-pro, etc.
NEXUS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NEXUS_OPENROUTER_TEMPERATURE=0.7              # LLM temperature (0.0-1.0)
NEXUS_OPENROUTER_MAX_TOKENS=1000              # Maximum tokens in LLM response

# =============================================================================
# API Validation and Router Discovery Configuration
# =============================================================================

# OpenAPI Validation
# Enable validation of FastAPI routes against OpenAPI schema specifications.
# This checks that all defined API endpoints match their OpenAPI schemas.
# NOTE: This is NOT related to OpenRouter (the LLM service above).
NEXUS_OPENAPI_VALIDATION_ENABLED=true

# Router Discovery
# Enable automatic router discovery and registration.
# When enabled, routers are automatically discovered from domain directories
# without manual import and registration in main.py.
NEXUS_ROUTER_DISCOVERY_ENABLED=true

# Exclude Modules
# Comma-separated list of module names to exclude from automatic discovery.
# Example: "core,utils,websocket"
NEXUS_ROUTER_EXCLUDE_MODULES=

# =============================================================================
# Workflow Engine Configuration
# =============================================================================

# Activity Execution Timeouts
NEXUS_API_TIMEOUT_SECONDS=30              # Default timeout for API requests in seconds
NEXUS_SCRIPT_TIMEOUT_SECONDS=300          # Default timeout for script execution in seconds (5 minutes)
NEXUS_AGENTIC_TIMEOUT_SECONDS=300         # Default timeout for agentic activities (5 minutes)

# Duration Validation Limits (0 = unlimited)
NEXUS_MAX_DURATION_HOURS=8760             # Maximum duration in hours (8760 = 1 year)
NEXUS_MAX_DURATION_MINUTES=525600         # Maximum duration in minutes (525600 = 1 year)
NEXUS_MAX_DURATION_SECONDS=31536000       # Maximum duration in seconds (31536000 = 1 year)

# Script Execution Settings
NEXUS_SCRIPT_CLEANUP_TERMINATE_TIMEOUT=1.0  # Timeout for graceful process termination
NEXUS_SCRIPT_CLEANUP_KILL_TIMEOUT=0.5       # Timeout for forceful process kill
NEXUS_MAX_ENV_VAR_LENGTH=32768              # Maximum length per environment variable (32KB)

# Agentic Activity Settings
NEXUS_MAX_PROMPT_LENGTH=100000            # Maximum prompt length (100KB)
NEXUS_MAX_INPUT_VALUE_LENGTH=10000        # Maximum length for individual input values (10KB)
NEXUS_MAX_TOTAL_INPUT_SIZE=50000          # Maximum total size of all input values (50KB)

# Service-to-Service Communication URLs
# NOTE: These are automatically configured in podman-compose.yml with correct container networking.
# Only uncomment and override if running services outside of containers or for custom deployment scenarios.
# NEXUS_WORKFLOW_BASE_URL=http://localhost:8000/api/v1        # Override workflow engine base URL (default: http://nexus:8000/api/v1 in containers)
# NEXUS_AGENT_ORCHESTRATOR_BASE_URL=http://localhost:8000/api/v1  # Override agent orchestrator API base URL (default: http://nexus:8000/api/v1 in containers)

# System User for Automated Operations
NEXUS_SYSTEM_USER_ID=00000000-0000-0000-0000-000000000001

# Workflow Execution Limits
NEXUS_MAX_LOOP_ITERATIONS=10000           # Maximum iterations for loops to prevent runaway execution

# =============================================================================
# AAP (Ansible Automation Platform) Configuration
# =============================================================================

# AAP Connection Settings (for AAP Job Template executor)
NEXUS_AAP_BASE_URL=https://aap.example.com     # AAP Controller base URL
NEXUS_AAP_USERNAME=workflow_user               # AAP username (optional if using token)
NEXUS_AAP_PASSWORD=secret_password             # AAP password (optional if using token)
NEXUS_AAP_TOKEN=your_api_token_here            # AAP API token (preferred over username/password)
NEXUS_AAP_VERIFY_SSL=true                      # Verify SSL certificates (set to false for self-signed certs in dev/test)

# AAP Activity Settings
NEXUS_AAP_TIMEOUT_SECONDS=3600                 # Default timeout for AAP job template activities (1 hour)
NEXUS_AAP_POLL_INTERVAL_SECONDS=5.0            # Job status polling interval (AAP recommendation: 5 seconds)
