{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syntara-orchestration.io/schemas/workflows/v2/control-nodes/wait",
  "title": "Wait Node",
  "description": "Pause workflow execution for a specified duration",
  "configSchema": {
    "type": "object",
    "required": ["duration"],
    "properties": {
      "duration": {
        "type": "integer",
        "minimum": 1,
        "description": "Total wait duration in seconds"
      }
    },
    "additionalProperties": false
  },
  "settingSchema": {
    "type": "object",
    "properties": {
      "continue_on_failure": {
        "type": "boolean",
        "description": "When true, downstream nodes continue executing even if this node fails. Inherits from global settings when absent."
      }
    },
    "additionalProperties": false
  },
  "resultSchema": {
    "description": "Result structure available in result namespace",
    "oneOf": [
      {
        "title": "Completed Result",
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "const": "completed",
            "description": "Wait duration elapsed successfully"
          }
        },
        "additionalProperties": false
      },
      {
        "title": "Failed Result",
        "$ref": "../common-definitions.schema.json#/$defs/baseFailedResult"
      }
    ],
    "discriminator": {
      "propertyName": "status"
    }
  }
}
