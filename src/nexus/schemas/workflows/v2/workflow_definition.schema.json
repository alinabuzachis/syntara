{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syntara-orchestration.io/schemas/workflows/v2/workflow_definition",
  "title": "Workflow Definition Schema v2",
  "description": "JSON Schema for graph-based workflow definitions in the Nexus Workflow Engine v2",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "triggers",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "description": "Schema version that this workflow definition conforms to"
    },
    "name": {
      "type": "string",
      "description": "Workflow name",
      "minLength": 1,
      "maxLength": 255
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the workflow's purpose",
      "minLength": 1,
      "maxLength": 1000
    },
    "triggers": {
      "type": "array",
      "description": "Trigger nodes that define how the workflow is initiated. Must contain at least one trigger. Trigger nodes must be graph entry points (no incoming edges) — enforced by application-level validation.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/trigger_node"
      }
    },
    "nodes": {
      "type": "array",
      "description": "Execution and control nodes in the workflow graph",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "description": "List of directed edges connecting triggers and nodes in the workflow graph",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node_base": {
      "type": "object",
      "description": "Base node properties shared by all node types",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "type",
        "config"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the node within the workflow",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name for the node (display only)",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the node purpose",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "description": "Node type identifier"
        },
        "config": {
          "type": "object",
          "description": "Type-specific configuration - see individual node type schemas for details"
        },
        "outputs": {
          "type": "object",
          "description": "Output extraction mapping (optional - defaults to full result). Reserved field names 'status' and 'error' cannot be used.",
          "patternProperties": {
            "^(?!status$|error$)[a-zA-Z_][a-zA-Z0-9_]*$": {
              "type": "string",
              "description": "Template expression to extract output value"
            }
          },
          "additionalProperties": false,
          "examples": [
            {
              "job_id": "${result.job_id}",
              "job_status": "${result.job_status}"
            },
            {
              "first_server": "${result.artifacts.servers[0]}",
              "second_server": "${result.artifacts.servers[1]}"
            },
            {
              "summary": "${result.output.summary}",
              "priority": "${result.output.priority}"
            }
          ]
        },
        "retry_policy": {
          "$ref": "common-definitions.schema.json#/$defs/retry_policy",
          "description": "Node-specific retry policy. If not specified, defaults to unlimited retries with exponential backoff until timeout is reached."
        },
        "timeout": {
          "type": "integer",
          "description": "Node execution timeout in seconds. If not specified, the platform default for the node's executor type is used.",
          "minimum": 1
        }
      }
    },
    "trigger_node": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "manual_trigger"
                },
                "config": {
                  "$ref": "triggers/manual.schema.json#/configSchema"
                }
              }
            }
          ]
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "aap_job_template"
                },
                "config": {
                  "$ref": "executors/aap_job_template.schema.json#/configSchema"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "aap_workflow_job_template"
                },
                "config": {
                  "$ref": "executors/aap_workflow_job_template.schema.json#/configSchema"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "http_request"
                },
                "config": {
                  "$ref": "executors/http_request.schema.json#/configSchema"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "agentic"
                },
                "config": {
                  "$ref": "executors/agentic.schema.json#/configSchema"
                }
              }
            }
          ]
        },
        {
          "$comment": "TEMPORARY: Script node added for initial testing only",
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "script"
                },
                "config": {
                  "$ref": "executors/script.schema.json#/configSchema"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "approval"
                },
                "config": {
                  "$ref": "executors/approval.schema.json#/configSchema"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "condition"
                },
                "config": {
                  "$ref": "control-nodes/condition.schema.json#/configSchema"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "loop"
                },
                "config": {
                  "$ref": "control-nodes/loop.schema.json#/configSchema"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/node_base"
            },
            {
              "properties": {
                "type": {
                  "const": "converge"
                },
                "config": {
                  "$ref": "control-nodes/converge.schema.json#/configSchema"
                }
              }
            }
          ]
        }
      ]
    },
    "edge": {
      "type": "object",
      "description": "Edge connecting two nodes or a trigger and a node",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "description": "Source node or trigger ID",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "to": {
          "type": "string",
          "description": "Target node ID (triggers cannot be edge targets)",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "from_port": {
          "type": "string",
          "description": "Output port on the source. Required for multi-output nodes (condition, loop) to specify which execution path this edge represents. Condition nodes use 'true'/'false', loop nodes use 'iterate'/'complete'. Port-to-node-type consistency is enforced at the application level.",
          "oneOf": [
            {
              "const": "true",
              "description": "Condition output port: edge is taken when the condition evaluates to true"
            },
            {
              "const": "false",
              "description": "Condition output port: edge is taken when the condition evaluates to false"
            },
            {
              "const": "iterate",
              "description": "Loop output port: edge leads to the loop body, executed once per iteration of the loop"
            },
            {
              "const": "complete",
              "description": "Loop output port: edge leads to post-loop work, executed once after all iterations finish"
            }
          ]
        },
        "to_port": {
          "type": "string",
          "description": "Input port on the target node. Used to distinguish how an edge arrives at a node.",
          "oneOf": [
            {
              "const": "iterate",
              "description": "Loop input port: feedback edge from the loop body that routes output back to the loop node for the next iteration."
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
