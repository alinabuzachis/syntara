{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syntara-orchestration.io/schemas/workflows/v2/executors/http_request",
  "title": "HTTP Request Node",
  "description": "Make HTTP API calls",
  "configSchema": {
    "type": "object",
    "required": ["method", "url"],
    "properties": {
      "method": {
        "type": "string",
        "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"],
        "description": "HTTP method"
      },
      "url": {
        "type": "string",
        "description": "API endpoint URL (value supports templating)",
        "minLength": 1,
        "pattern": "^(https?://|\\$)",
        "examples": [
          "https://api.example.com/v1/resource",
          "${trigger.api_base_url}/endpoint"
        ]
      },
      "headers": {
        "type": "object",
        "description": "HTTP headers (values support templating)",
        "additionalProperties": {
          "type": "string"
        }
      },
      "query_params": {
        "type": "object",
        "description": "URL query parameters (values support templating)",
        "additionalProperties": {
          "oneOf": [
            {"type": "string"},
            {"type": "number"},
            {"type": "boolean"},
            {"type": "null"}
          ]
        }
      },
      "body": {
        "description": "Request body (supports templating). Can be object (serialized as JSON), string (sent as-is), array, or null.",
        "oneOf": [
          {"type": "object"},
          {"type": "string"},
          {"type": "array"},
          {"type": "null"}
        ]
      },
      "authentication": {
        "type": "object",
        "description": "Authentication configuration",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["basic", "bearer", "api_key", "oauth2"],
            "description": "Authentication type"
          },
          "credentials": {
            "type": "string",
            "description": "Reference to stored credentials"
          }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "resultSchema": {
    "description": "Result structure available in result namespace (discriminated union)",
    "oneOf": [
      {
        "title": "Completed Result",
        "type": "object",
        "required": ["status", "status_code", "body", "headers", "elapsed"],
        "properties": {
          "status": {
            "type": "string",
            "const": "completed",
            "description": "Execution succeeded"
          },
          "status_code": {
            "type": "integer",
            "description": "HTTP status code"
          },
          "body": {
            "description": "Response body (parsed JSON or raw string)"
          },
          "headers": {
            "type": "object",
            "description": "Response headers",
            "additionalProperties": {
              "type": "string"
            }
          },
          "elapsed": {
            "type": "number",
            "description": "Request duration in seconds"
          }
        },
        "additionalProperties": false
      },
      {
        "title": "Failed Result",
        "$ref": "../common-definitions.schema.json#/$defs/baseFailedResult"
      }
    ],
    "discriminator": {
      "propertyName": "status"
    }
  }
}
