{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syntara-orchestration.io/schemas/workflows/v2/executors/aap_job_template",
  "title": "AAP Job Template Node",
  "description": "Launch Ansible Automation Platform job templates",
  "configSchema": {
    "type": "object",
    "description": "Job template must be specified by ID or name. When both are provided, ID takes precedence.",
    "properties": {
      "credential_id": {
        "$ref": "../common-definitions.schema.json#/$defs/credential_id"
      },
      "job_template_id": {
        "type": "integer",
        "description": "AAP job template ID to launch (takes precedence over name)",
        "minimum": 1
      },
      "job_template_name": {
        "type": "string",
        "description": "AAP job template name (requires organization_name)",
        "minLength": 1
      },
      "organization_name": {
        "type": "string",
        "description": "AAP organization name (required with name-based lookup)",
        "minLength": 1
      },
      "inventory_id": {
        "type": "integer",
        "description": "Override default inventory by ID",
        "minimum": 1
      },
      "inventory_name": {
        "type": "string",
        "description": "Override default inventory by name (requires organization_name)",
        "minLength": 1
      },
      "job_credentials": {
        "type": "array",
        "description": "List of AAP credential IDs to pass to the job template (overrides template defaults)",
        "items": {
          "type": "integer",
          "minimum": 1
        }
      },
      "extra_vars": {
        "type": "object",
        "description": "Extra variables to pass to the job (supports templating)",
        "additionalProperties": true
      },
      "limit": {
        "type": "string",
        "description": "Limit job execution to specific hosts"
      },
      "tags": {
        "type": "string",
        "description": "Ansible tags to run (comma-separated)"
      },
      "skip_tags": {
        "type": "string",
        "description": "Ansible tags to skip (comma-separated)"
      },
      "verbosity": {
        "type": "integer",
        "description": "Job verbosity level (0-5)",
        "minimum": 0,
        "maximum": 5,
        "default": 0
      },
      "timeout": {
        "type": "integer",
        "description": "Timeout for job execution in seconds",
        "minimum": 1
      },
      "job_type": {
        "type": "string",
        "description": "Job type override: 'run' or 'check' (dry run)",
        "enum": ["run", "check"]
      },
      "forks": {
        "type": "integer",
        "description": "Number of parallel forks for job execution",
        "minimum": 0
      },
      "job_slicing": {
        "type": "integer",
        "description": "Number of job slices",
        "minimum": 1
      },
      "diff_mode": {
        "type": "boolean",
        "description": "Enable diff mode for playbook runs"
      },
      "execution_environment": {
        "type": "string",
        "description": "Execution environment override (deferred — requires ID resolution)"
      },
      "instance_groups": {
        "type": "string",
        "description": "Instance groups override (deferred — requires ID resolution)"
      },
      "labels": {
        "type": "string",
        "description": "Labels (deferred — requires ID resolution)"
      }
    },
    "anyOf": [
      {
        "required": ["job_template_id"]
      },
      {
        "required": ["job_template_name", "organization_name"]
      }
    ],
    "allOf": [
      {
        "if": {
          "required": ["inventory_name"]
        },
        "then": {
          "required": ["organization_name"]
        }
      }
    ],
    "additionalProperties": false
  },
  "resultSchema": {
    "description": "Result structure available in result namespace (discriminated union)",
    "oneOf": [
      {
        "title": "Completed Result",
        "type": "object",
        "required": ["status", "job_id", "job_status", "created", "started", "finished"],
        "properties": {
          "status": {
            "type": "string",
            "const": "completed",
            "description": "Execution succeeded"
          },
          "job_id": {
            "type": "integer",
            "description": "AAP job ID"
          },
          "job_status": {
            "type": "string",
            "description": "Job status (successful, failed, etc.)"
          },
          "artifacts": {
            "type": "object",
            "description": "Job artifacts/facts",
            "additionalProperties": true
          },
          "created": {
            "type": "string",
            "description": "Job creation timestamp (ISO 8601)"
          },
          "started": {
            "type": "string",
            "description": "Job start timestamp (ISO 8601)"
          },
          "finished": {
            "type": "string",
            "description": "Job finish timestamp (ISO 8601)"
          }
        },
        "additionalProperties": false
      },
      {
        "title": "Failed Result",
        "allOf": [
          {
            "$ref": "../common-definitions.schema.json#/$defs/baseFailedResult"
          },
          {
            "type": "object",
            "properties": {
              "job_id": {
                "type": "integer",
                "description": "AAP job ID (if job was launched before failure)"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    ],
    "discriminator": {
      "propertyName": "status"
    }
  }
}
