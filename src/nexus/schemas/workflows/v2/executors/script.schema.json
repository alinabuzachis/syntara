{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syntara-orchestration.io/schemas/workflows/v2/executors/script",
  "title": "Script Node",
  "description": "Execute scripts in various languages (TEMPORARY - added for initial testing)",
  "configSchema": {
    "type": "object",
    "required": ["language", "code"],
    "properties": {
      "language": {
        "type": "string",
        "enum": ["python", "bash"],
        "description": "Script language/runtime"
      },
      "code": {
        "type": "string",
        "description": "Script code to execute",
        "minLength": 1
      },
      "environment": {
        "type": "object",
        "description": "Environment variables to set during script execution",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "resultSchema": {
    "description": "Result structure available in result namespace (discriminated union)",
    "oneOf": [
      {
        "title": "Completed Result",
        "type": "object",
        "required": ["status", "return_code", "stdout", "stderr"],
        "properties": {
          "status": {
            "type": "string",
            "const": "completed",
            "description": "Script execution completed"
          },
          "return_code": {
            "type": "integer",
            "description": "Script exit code (0 = success)"
          },
          "stdout": {
            "type": "string",
            "description": "Standard output from script execution"
          },
          "stderr": {
            "type": "string",
            "description": "Standard error from script execution"
          },
          "stdout_json": {
            "description": "Parsed JSON from stdout (Python scripts only). Present if stdout contains valid JSON (entire stdout or last line)."
          }
        },
        "additionalProperties": false
      },
      {
        "title": "Failed Result",
        "$ref": "../common-definitions.schema.json#/$defs/baseFailedResult"
      }
    ],
    "discriminator": {
      "propertyName": "status"
    }
  }
}
