{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://syntara-orchestration.io/schemas/workflow-definition/v1.0.0",
  "title": "Workflow Definition Schema",
  "description": "JSON Schema for workflow YAML definitions in the Nexus Workflow Engine",
  "type": "object",
  "required": ["schemaVersion", "version", "metadata", "workflow"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Schema version that this workflow definition conforms to (semver format)",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "examples": ["1.0.0", "1.1.0", "2.0.0"]
    },
    "version": {
      "type": "integer",
      "description": "Workflow definition version number (increments with each change)",
      "minimum": 1,
      "examples": [1, 2, 3]
    },
    "metadata": {
      "type": "object",
      "description": "Workflow metadata and configuration",
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique name for the workflow",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the workflow purpose",
          "minLength": 1,
          "maxLength": 1000
        },
        "tags": {
          "type": "array",
          "description": "Tags for categorization and search",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "uniqueItems": true
        },
        "owner": {
          "type": "string",
          "description": "User or team responsible for the workflow",
          "minLength": 1
        },
        "timeout": {
          "type": "integer",
          "description": "Maximum workflow execution time in seconds - applies to entire workflow",
          "minimum": 1,
          "examples": [3600, 86400, 1800]
        }
      },
      "additionalProperties": false
    },
    "triggers": {
      "type": "array",
      "description": "Workflow trigger configuration - manual trigger only",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/manualTrigger"
      }
    },
    "inputs": {
      "type": "object",
      "description": "Input parameter definitions for the workflow",
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "$ref": "#/definitions/parameter"
        }
      },
      "additionalProperties": false
    },
    "variables": {
      "type": "object",
      "description": "Workflow-level variables that can be referenced throughout the workflow",
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "description": "Variable value (can be string, number, boolean, object, array, or null)",
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" },
            { "type": "object" },
            { "type": "array" }
          ]
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "description": "Secret references for credentials and sensitive data (values stored securely, not in workflow definition)",
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "type": "object",
          "required": ["secretId"],
          "properties": {
            "secretId": {
              "type": "string",
              "description": "Reference to secret stored in secret manager",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "enum": ["api_key", "bearer_token", "basic_auth", "oauth2", "custom"],
              "description": "Type of secret for validation",
              "default": "custom"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "description": "The workflow execution definition",
      "required": ["activities"],
      "properties": {
        "activities": {
          "type": "array",
          "description": "List of activities to execute in the workflow",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/activity"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "manualTrigger": {
      "type": "object",
      "description": "Manual trigger - user initiates workflow execution",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "manual"
        },
        "requiresApproval": {
          "type": "boolean",
          "description": "Whether manual execution requires approval",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "description": "Parameter definition with type and validation",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "number", "integer", "boolean", "object", "array"],
          "description": "Parameter data type"
        },
        "description": {
          "type": "string",
          "description": "Human-readable parameter description"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "Whether the parameter is required"
        },
        "default": {
          "description": "Default value if not provided"
        },
        "enum": {
          "type": "array",
          "description": "Allowed values for the parameter",
          "minItems": 1
        },
        "pattern": {
          "type": "string",
          "description": "Regex pattern for string validation"
        },
        "minimum": {
          "type": "number",
          "description": "Minimum value for numeric parameters"
        },
        "maximum": {
          "type": "number",
          "description": "Maximum value for numeric parameters"
        }
      },
      "additionalProperties": false
    },
    "baseActivity": {
      "type": "object",
      "description": "Base properties common to all activity types",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the activity within the workflow",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name for the activity",
          "minLength": 1
        },
        "requiresApproval": {
          "type": "boolean",
          "description": "Whether this activity requires human approval before execution",
          "default": false
        },
        "approval": {
          "$ref": "#/definitions/approvalDefinition",
          "description": "Human approval configuration (required if requiresApproval is true)"
        },
        "retryPolicy": {
          "$ref": "#/definitions/retryPolicy"
        },
        "timeout": {
          "type": "integer",
          "description": "Activity timeout in seconds",
          "minimum": 1
        },
        "outputs": {
          "type": "object",
          "description": "Output schema definition for this activity",
          "patternProperties": {
            "^[a-zA-Z_][a-zA-Z0-9_]*$": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["string", "number", "integer", "boolean", "object", "array"],
                  "description": "Expected output type"
                },
                "description": {
                  "type": "string",
                  "description": "Description of this output"
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "taskActivity": {
      "allOf": [
        { "$ref": "#/definitions/baseActivity" }
      ],
      "type": "object",
      "required": ["type", "task"],
      "properties": {
        "type": {
          "const": "task"
        },
        "task": {
          "$ref": "#/definitions/taskDefinition",
          "description": "Task definition"
        }
      },
      "unevaluatedProperties": false
    },
    "parallelActivity": {
      "allOf": [
        { "$ref": "#/definitions/baseActivity" }
      ],
      "type": "object",
      "required": ["type", "branches"],
      "properties": {
        "type": {
          "const": "parallel"
        },
        "branches": {
          "type": "array",
          "description": "Activities to execute in parallel",
          "minItems": 2,
          "items": {
            "$ref": "#/definitions/activity"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "sequenceActivity": {
      "allOf": [
        { "$ref": "#/definitions/baseActivity" }
      ],
      "type": "object",
      "required": ["type", "steps"],
      "properties": {
        "type": {
          "const": "sequence"
        },
        "steps": {
          "type": "array",
          "description": "Activities to execute sequentially",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/activity"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "conditionActivity": {
      "allOf": [
        { "$ref": "#/definitions/baseActivity" }
      ],
      "type": "object",
      "required": ["type", "condition", "then"],
      "properties": {
        "type": {
          "const": "condition"
        },
        "condition": {
          "type": "string",
          "description": "Conditional expression",
          "minLength": 1,
          "examples": ["${output.status == 'success'}", "${input.amount > 1000}"]
        },
        "then": {
          "type": "array",
          "description": "Activities to execute if condition is true",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/activity"
          }
        },
        "else": {
          "type": "array",
          "description": "Activities to execute if condition is false",
          "items": {
            "$ref": "#/definitions/activity"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "loopActivity": {
      "allOf": [
        { "$ref": "#/definitions/baseActivity" }
      ],
      "type": "object",
      "required": ["type", "loop"],
      "properties": {
        "type": {
          "const": "loop"
        },
        "loop": {
          "$ref": "#/definitions/loopDefinition",
          "description": "Loop definition"
        }
      },
      "unevaluatedProperties": false
    },
    "convergeActivity": {
      "allOf": [
        { "$ref": "#/definitions/baseActivity" }
      ],
      "type": "object",
      "required": ["type", "converge"],
      "properties": {
        "type": {
          "const": "converge"
        },
        "converge": {
          "$ref": "#/definitions/convergeDefinition",
          "description": "Converge definition"
        }
      },
      "unevaluatedProperties": false
    },
    "approvalActivity": {
      "allOf": [
        { "$ref": "#/definitions/baseActivity" }
      ],
      "type": "object",
      "description": "Human approval node - pauses branch execution until approved or rejected",
      "required": ["type", "onApproved"],
      "properties": {
        "type": {
          "const": "approval"
        },
        "description": {
          "type": "string",
          "description": "Detailed context/prompt for approvers explaining what they are approving"
        },
        "onApproved": {
          "type": "array",
          "description": "Activities to execute when approval is granted",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/activity"
          }
        },
        "onRejected": {
          "type": "array",
          "description": "Activities to execute when approval is rejected or expires",
          "items": {
            "$ref": "#/definitions/activity"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "activity": {
      "oneOf": [
        { "$ref": "#/definitions/taskActivity" },
        { "$ref": "#/definitions/parallelActivity" },
        { "$ref": "#/definitions/sequenceActivity" },
        { "$ref": "#/definitions/conditionActivity" },
        { "$ref": "#/definitions/loopActivity" },
        { "$ref": "#/definitions/convergeActivity" },
        { "$ref": "#/definitions/approvalActivity" }
      ],
      "discriminator": {
        "propertyName": "type",
        "mapping": {
          "task": "#/definitions/taskActivity",
          "parallel": "#/definitions/parallelActivity",
          "sequence": "#/definitions/sequenceActivity",
          "condition": "#/definitions/conditionActivity",
          "loop": "#/definitions/loopActivity",
          "converge": "#/definitions/convergeActivity",
          "approval": "#/definitions/approvalActivity"
        }
      }
    },
    "baseTaskDefinition": {
      "type": "object",
      "description": "Base properties common to all task executor types",
      "required": ["executor"],
      "properties": {
        "inputs": {
          "type": "object",
          "description": "Input mapping for the task (can reference workflow inputs or previous outputs)",
          "additionalProperties": true
        },
        "outputs": {
          "type": "object",
          "description": "Output mapping from the task",
          "patternProperties": {
            "^[a-zA-Z_][a-zA-Z0-9_]*$": {
              "type": "string",
              "description": "JSONPath or expression to extract output value"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "agenticTask": {
      "allOf": [
        { "$ref": "#/definitions/baseTaskDefinition" }
      ],
      "type": "object",
      "required": ["executor", "config"],
      "properties": {
        "executor": {
          "const": "agentic",
          "description": "Task executor type"
        },
        "config": {
          "type": "object",
          "required": ["agent"],
          "properties": {
            "agent": {
              "type": "string",
              "description": "Agent identifier or MCP server endpoint",
              "minLength": 1
            },
            "tools": {
              "type": "array",
              "description": "List of tools available to the agent",
              "items": {
                "type": "string"
              }
            },
            "prompt": {
              "type": "string",
              "description": "Natural language prompt for the agent"
            },
            "model": {
              "type": "string",
              "description": "LLM model to use",
              "examples": ["gpt-4", "claude-3-opus", "gemini-pro"]
            }
          },
          "additionalProperties": true
        }
      },
      "unevaluatedProperties": false
    },
    "scriptTask": {
      "allOf": [
        { "$ref": "#/definitions/baseTaskDefinition" }
      ],
      "type": "object",
      "required": ["executor", "config"],
      "properties": {
        "executor": {
          "const": "script",
          "description": "Task executor type"
        },
        "config": {
          "type": "object",
          "required": ["language", "code"],
          "properties": {
            "language": {
              "type": "string",
              "enum": ["python", "bash"],
              "description": "Script language"
            },
            "code": {
              "type": "string",
              "description": "Script code to execute",
              "minLength": 1
            },
            "environment": {
              "type": "object",
              "description": "Environment variables for script execution",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "apiTask": {
      "allOf": [
        { "$ref": "#/definitions/baseTaskDefinition" }
      ],
      "type": "object",
      "required": ["executor", "config"],
      "properties": {
        "executor": {
          "const": "api",
          "description": "Task executor type"
        },
        "config": {
          "type": "object",
          "required": ["method", "url"],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"],
              "description": "HTTP method"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "API endpoint URL"
            },
            "headers": {
              "type": "object",
              "description": "HTTP headers",
              "additionalProperties": {
                "type": "string"
              }
            },
            "queryParams": {
              "type": "object",
              "description": "URL query parameters",
              "additionalProperties": true
            },
            "body": {
              "description": "Request body (can use template expressions)"
            },
            "authentication": {
              "type": "object",
              "description": "Authentication configuration",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["basic", "bearer", "apiKey", "oauth2"],
                  "description": "Authentication type"
                },
                "credentials": {
                  "type": "string",
                  "description": "Reference to stored credentials",
                  "pattern": "^\\$\\{secrets\\.[a-zA-Z0-9_]+\\}$"
                }
              },
              "required": ["type"],
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "connectorTask": {
      "allOf": [
        { "$ref": "#/definitions/baseTaskDefinition" }
      ],
      "type": "object",
      "required": ["executor", "config"],
      "properties": {
        "executor": {
          "const": "connector",
          "description": "Task executor type"
        },
        "config": {
          "type": "object",
          "required": ["connectorId", "operation"],
          "properties": {
            "connectorId": {
              "type": "string",
              "description": "Registered connector identifier",
              "minLength": 1
            },
            "operation": {
              "type": "string",
              "description": "Operation to execute on the connector",
              "minLength": 1
            },
            "parameters": {
              "type": "object",
              "description": "Connector operation parameters",
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "aapJobTemplateTask": {
      "allOf": [
        { "$ref": "#/definitions/baseTaskDefinition" }
      ],
      "type": "object",
      "required": ["executor", "config"],
      "properties": {
        "executor": {
          "const": "aap_job_template",
          "description": "Task executor type - Ansible Automation Platform Job Template"
        },
        "config": {
          "type": "object",
          "description": "Configuration for AAP job template execution. Must specify either jobTemplateId OR both jobTemplateName and organizationName.",
          "properties": {
            "jobTemplateId": {
              "type": "integer",
              "description": "AAP job template ID to launch (mutually exclusive with jobTemplateName/organizationName)",
              "minimum": 1
            },
            "jobTemplateName": {
              "type": "string",
              "description": "AAP job template name (requires organizationName, mutually exclusive with jobTemplateId)"
            },
            "organizationName": {
              "type": "string",
              "description": "AAP organization name (requires jobTemplateName, mutually exclusive with jobTemplateId)"
            },
            "inventory": {
              "type": "integer",
              "minimum": 1,
              "description": "Override default inventory (ID only)"
            },
            "credentials": {
              "type": "array",
              "description": "List of credential IDs to use",
              "items": {
                "type": "integer"
              }
            },
            "extraVars": {
              "type": "object",
              "description": "Extra variables to pass to the job (can use expressions like ${input.version})",
              "additionalProperties": true
            },
            "limit": {
              "type": "string",
              "description": "Limit job execution to specific hosts"
            },
            "tags": {
              "type": "string",
              "description": "Ansible tags to run (comma-separated)"
            },
            "skipTags": {
              "type": "string",
              "description": "Ansible tags to skip (comma-separated)"
            },
            "verbosity": {
              "type": "integer",
              "description": "Job verbosity level",
              "minimum": 0,
              "maximum": 5,
              "default": 0
            }
          },
          "oneOf": [
            {
              "required": ["jobTemplateId"],
              "not": {
                "anyOf": [
                  { "required": ["jobTemplateName"] },
                  { "required": ["organizationName"] }
                ]
              }
            },
            {
              "required": ["jobTemplateName", "organizationName"],
              "not": {
                "required": ["jobTemplateId"]
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "unevaluatedProperties": false
    },
    "taskDefinition": {
      "oneOf": [
        { "$ref": "#/definitions/agenticTask" },
        { "$ref": "#/definitions/scriptTask" },
        { "$ref": "#/definitions/apiTask" },
        { "$ref": "#/definitions/connectorTask" },
        { "$ref": "#/definitions/aapJobTemplateTask" }
      ],
      "discriminator": {
        "propertyName": "executor",
        "mapping": {
          "agentic": "#/definitions/agenticTask",
          "script": "#/definitions/scriptTask",
          "api": "#/definitions/apiTask",
          "connector": "#/definitions/connectorTask",
          "aap_job_template": "#/definitions/aapJobTemplateTask"
        }
      }
    },
    "baseLoop": {
      "type": "object",
      "description": "Base properties common to all loop types",
      "required": ["type", "do"],
      "properties": {
        "do": {
          "type": "array",
          "description": "Activities to execute in each iteration",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/activity"
          }
        }
      }
    },
    "forEachLoop": {
      "allOf": [
        { "$ref": "#/definitions/baseLoop" }
      ],
      "type": "object",
      "required": ["type", "items"],
      "properties": {
        "type": {
          "const": "forEach"
        },
        "items": {
          "type": "string",
          "description": "Expression referencing array to iterate over",
          "examples": ["${input.users}", "${output.results}"]
        },
        "itemVariable": {
          "type": "string",
          "description": "Variable name for current item",
          "default": "item",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "indexVariable": {
          "type": "string",
          "description": "Variable name for current index",
          "default": "index",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        }
      },
      "unevaluatedProperties": false
    },
    "whileLoop": {
      "allOf": [
        { "$ref": "#/definitions/baseLoop" }
      ],
      "type": "object",
      "required": ["type", "condition"],
      "properties": {
        "type": {
          "const": "while"
        },
        "condition": {
          "type": "string",
          "description": "Condition expression to evaluate before each iteration",
          "minLength": 1,
          "examples": ["${counter < 10}", "${!completed}"]
        },
        "maxIterations": {
          "type": "integer",
          "description": "Maximum number of iterations to prevent infinite loops",
          "minimum": 1,
          "maximum": 10000,
          "default": 1000
        }
      },
      "unevaluatedProperties": false
    },
    "loopDefinition": {
      "oneOf": [
        { "$ref": "#/definitions/forEachLoop" },
        { "$ref": "#/definitions/whileLoop" }
      ],
      "discriminator": {
        "propertyName": "type",
        "mapping": {
          "forEach": "#/definitions/forEachLoop",
          "while": "#/definitions/whileLoop"
        }
      }
    },
    "approvalDefinition": {
      "type": "object",
      "description": "Human approval configuration",
      "required": ["approvers", "prompt"],
      "properties": {
        "approvers": {
          "type": "array",
          "description": "List of users or roles who can approve",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prompt": {
          "type": "string",
          "description": "Approval prompt/question to display",
          "minLength": 1
        },
        "timeout": {
          "type": "integer",
          "description": "Time to wait for approval in seconds",
          "minimum": 1,
          "examples": [3600, 86400]
        },
        "onTimeout": {
          "type": "string",
          "enum": ["approve", "reject", "fail"],
          "description": "Action to take if approval times out",
          "default": "fail"
        },
        "metadata": {
          "type": "object",
          "description": "Additional context to display to approvers",
          "additionalProperties": true
        },
        "outputs": {
          "type": "object",
          "description": "Output values from approval (e.g., approved, rejected, approver, timestamp)",
          "properties": {
            "approved": {
              "type": "boolean",
              "description": "Whether the approval was granted"
            },
            "approver": {
              "type": "string",
              "description": "User who approved or rejected"
            },
            "timestamp": {
              "type": "string",
              "description": "When approval/rejection occurred"
            },
            "comments": {
              "type": "string",
              "description": "Optional comments from approver"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "retryPolicy": {
      "type": "object",
      "description": "Retry configuration for failed activities",
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "description": "Maximum number of retry attempts",
          "minimum": 0,
          "maximum": 100,
          "default": 3
        },
        "backoff": {
          "type": "string",
          "enum": ["fixed", "exponential", "linear"],
          "description": "Backoff strategy between retries",
          "default": "exponential"
        },
        "initialInterval": {
          "type": "integer",
          "description": "Initial retry interval in seconds",
          "minimum": 1,
          "default": 1,
          "examples": [1, 5, 10]
        },
        "maxInterval": {
          "type": "integer",
          "description": "Maximum retry interval in seconds",
          "minimum": 1,
          "examples": [60, 300]
        },
        "multiplier": {
          "type": "number",
          "description": "Backoff multiplier for exponential strategy",
          "minimum": 1,
          "maximum": 10,
          "default": 2
        },
        "retryableErrors": {
          "type": "array",
          "description": "List of error types or codes that should trigger retry",
          "items": {
            "type": "string"
          },
          "examples": [["TIMEOUT", "NETWORK_ERROR", "RATE_LIMIT"]]
        }
      },
      "additionalProperties": false
    },
    "convergeDefinition": {
      "type": "object",
      "description": "Converge pattern configuration - waits for specific activities to complete before proceeding",
      "required": ["branches"],
      "properties": {
        "branches": {
          "type": "array",
          "description": "List of activity IDs to wait for",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "uniqueItems": true
        },
        "strategy": {
          "type": "string",
          "enum": ["all"],
          "description": "Converge strategy: 'all' waits for all specified branches",
          "default": "all"
        },
        "timeout": {
          "type": "integer",
          "description": "Maximum time to wait for converge condition in seconds",
          "minimum": 1,
          "examples": [300, 1800, 3600]
        },
        "onTimeout": {
          "type": "string",
          "enum": ["continue", "fail"],
          "description": "Action to take if timeout is reached before converge condition is met",
          "default": "fail"
        },
        "aggregateOutputs": {
          "type": "boolean",
          "description": "Whether to aggregate outputs from completed branches into an object keyed by activity ID",
          "default": true
        }
      },
      "additionalProperties": false
    }
  }
}
