{
  "openapi": "3.0.3",
  "info": {
    "title": "Nexus Portal - Example API",
    "description": "Example API endpoint for demonstration purposes",
    "version": "1.0.0",
    "contact": {
      "name": "Nexus Portal"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1",
      "description": "Local development server"
    },
    {
      "url": "https://api.nexus.example.com/api/v1",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "example",
      "description": "Example operations"
    }
  ],
  "paths": {
    "/example": {
      "get": {
        "tags": ["example"],
        "summary": "Get example data",
        "description": "Returns example data for demonstration purposes",
        "operationId": "getExample",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of items to return",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "example": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ExampleItem"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "description": "Total number of items",
                      "example": 42
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      },
      "post": {
        "tags": ["example"],
        "summary": "Create example item",
        "description": "Creates a new example item",
        "operationId": "createExample",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExampleRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExampleItem"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/example/{item_id}": {
      "get": {
        "tags": ["example"],
        "summary": "Get example item by ID",
        "description": "Returns a single example item by its ID",
        "operationId": "getExampleById",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "description": "Example item ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExampleItem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      },
      "put": {
        "tags": ["example"],
        "summary": "Update example item",
        "description": "Updates an existing example item",
        "operationId": "updateExample",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "description": "Example item ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateExampleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExampleItem"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      },
      "delete": {
        "tags": ["example"],
        "summary": "Delete example item",
        "description": "Deletes an example item",
        "operationId": "deleteExample",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "description": "Example item ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Example item deleted successfully"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT authentication token. To be implemented in separate auth specification."
      }
    },
    "schemas": {
      "ExampleItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Unique identifier for the example item",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Name of the example item",
            "minLength": 1,
            "maxLength": 100,
            "example": "Example Item"
          },
          "description": {
            "type": "string",
            "description": "Description of the example item",
            "maxLength": 500,
            "example": "This is an example item for demonstration purposes"
          },
          "status": {
            "type": "string",
            "enum": ["active", "inactive"],
            "description": "Status of the example item",
            "example": "active"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the item was created",
            "example": "2025-11-10T10:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the item was last updated",
            "example": "2025-11-10T10:00:00Z"
          }
        },
        "required": ["id", "name", "status", "created_at", "updated_at"]
      },
      "CreateExampleRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the example item",
            "minLength": 1,
            "maxLength": 100,
            "example": "New Example Item"
          },
          "description": {
            "type": "string",
            "description": "Description of the example item",
            "maxLength": 500,
            "example": "This is a new example item"
          },
          "status": {
            "type": "string",
            "enum": ["active", "inactive"],
            "description": "Status of the example item",
            "default": "active",
            "example": "active"
          }
        },
        "required": ["name"]
      },
      "UpdateExampleRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the example item",
            "minLength": 1,
            "maxLength": 100,
            "example": "Updated Example Item"
          },
          "description": {
            "type": "string",
            "description": "Description of the example item",
            "maxLength": 500,
            "example": "This is an updated example item"
          },
          "status": {
            "type": "string",
            "enum": ["active", "inactive"],
            "description": "Status of the example item",
            "example": "active"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error type or code",
            "example": "validation_error"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message",
            "example": "Invalid request parameters"
          },
          "details": {
            "type": "object",
            "description": "Additional error details",
            "additionalProperties": true
          }
        },
        "required": ["error", "message"]
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Authentication required or invalid token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "unauthorized",
              "message": "Authentication required"
            }
          }
        }
      },
      "NotFoundError": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "not_found",
              "message": "Example item not found"
            }
          }
        }
      },
      "BadRequestError": {
        "description": "Invalid request parameters or validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "validation_error",
              "message": "Invalid request parameters"
            }
          }
        }
      }
    }
  }
}
